FROM python:3.12-slim

WORKDIR /app

# See prints in real-time
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app

# Install runtime + test deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest

# Copy application code and tests
COPY app /app/app
COPY front /app/app/front
COPY test /app/test

# Run the test suite using unittest discovery so `test/test.py` (unittest) is executed
CMD ["python", "-m", "unittest", "discover", "-v", "-s", "test", "-p", "test*.py"]