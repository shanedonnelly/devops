FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app \
	DATABASE_URL="postgresql://user:pass@localhost:5432/db?schema=public"

# System deps needed for prisma (node/libatomic)
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source, schema, and tests
COPY app.py models.py requirements.txt schema.prisma ./
COPY test ./test

# Generate Prisma client so "from prisma import Prisma" succeeds at import time
RUN prisma generate

# Run tests on container start; fail hard if any test fails
CMD ["sh", "-c", "pytest -q --disable-warnings || { echo 'Tests failed'; exit 1; }"]
