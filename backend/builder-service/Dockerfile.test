FROM python:3.12-slim

WORKDIR /app

# Install only test dependencies (minimal for running tests)
RUN pip install --no-cache-dir pytest python-jose bcrypt

# Copy source code and tests
COPY service.py .
COPY test_service.py .

# Run tests - container will exit with code 1 if tests fail
CMD ["pytest", "test_service.py", "-v", "--tb=short"]